# ============================================================
# PHASE 1 - FREE (fill these in, no monthly cost)
# ============================================================

# Pexels: https://www.pexels.com/api/  (free)
PEXELS_API_KEY=

# Pixabay: https://pixabay.com/api/docs/  (free)
PIXABAY_API_KEY=

# YouTube Data API v3 - Google Cloud Console (free)
# See setup_youtube_auth.py for the one-time OAuth steps.
YOUTUBE_CLIENT_SECRETS_FILE=.credentials/client_secret.json
YOUTUBE_TOKEN_FILE=.credentials/token.json

# ============================================================
# PHASE 2 - PREMIUM (leave blank until you upgrade, see PHASE2_UPGRADE.md)
# ============================================================

# ElevenLabs (replaces edge-tts)
ELEVENLABS_API_KEY=
ELEVENLABS_HINDI_VOICE_ID=

# Leonardo AI (replaces PIL thumbnails)
LEONARDO_API_KEY=

# OpenAI Whisper API (replaces faster-whisper)
OPENAI_API_KEY=

# Instagram Graph API (replaces manual reel upload)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
